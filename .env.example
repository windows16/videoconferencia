# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO - TELECONNECT
# (ESTE ARCHIVO ES PÚBLICO Y SIRVE COMO EJEMPLO; NO CONTIENE CLAVES REALES)
#
# Cada desarrollador o servidor debe crear su propio archivo local ".env"
# que estará ignorado por Git para no exponer claves ni accesos.
# ==============================================================================

# Clave de seguridad de Django (genera una clave aleatoria y segura para producción)
DJANGO_SECRET_KEY=clave-secreta-aleatoria-generada-localmente

# Modo de depuración (True para desarrollo local, False en producción)
DJANGO_DEBUG=True

# Hosts autorizados separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.8.0.1

# Parámetros del Servidor Seguro y VPN
VPN_SERVER_IP=10.8.0.1
VPN_SUBNET_PREFIX=10.8.0.
VPN_SERVER_PORT=443
VPN_SERVER_NAME=Telecom-Secure-Server
VPN_ENFORCE=False
