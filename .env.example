# ==========================================
# Variables de Entorno - TeleConnect
# ==========================================

# Django Config
DJANGO_SECRET_KEY=tu-clave-secreta-de-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com

# ==========================================
# SUPABASE AUTHENTICATION
# Obtén estos valores en: https://supabase.com -> Tu Proyecto -> Project Settings -> API
# ==========================================
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Configuración VPN
VPN_SERVER_IP=10.8.0.1
VPN_SUBNET_PREFIX=10.8.0.
VPN_SERVER_PORT=443
VPN_SERVER_NAME=Telecom-Secure-Server
VPN_ENFORCE=False
